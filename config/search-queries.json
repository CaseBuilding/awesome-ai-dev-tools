        "model context protocol in:description stars:>=5000"
      ],
      "max_results": 50
    },
    "code-analysis": {
      "name": "🔍 代码分析 / 理解",
      "search": [
        "(topic:code-analysis OR topic:code-review OR topic:static-analysis OR topic:code-intelligence) stars:>=5000",
        "code analysis in:name,description stars:>=5000",
        "code graph in:name,description stars:>=5000",
        "code intelligence in:description stars:>=5000",
        "understand code in:description stars:>=5000"
      ],
      "max_results": 40
    },
    "code-visualization": {
      "name": "🗺️ 代码导图 / 可视化",
      "search": [
        "(topic:dependency-graph OR topic:code-visualization OR topic:code-map OR topic:uml) stars:>=5000",
