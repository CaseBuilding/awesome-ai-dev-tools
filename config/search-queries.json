{
  "_说明": "每个分类同时搜索 topic 和 description/name，以捕获未打标签但有描述的项目。",
  "queries": {
    "ai-coding-agent": {
      "name": "🤖 AI Coding Agent",
      "search": [
        "(topic:ai-agent OR topic:coding-agent OR topic:code-assistant OR topic:ai-coding) stars:>=5000",
        "coding agent in:name,description stars:>=5000"
      ],
      "max_results": 50
    },
    "mcp": {
      "name": "🔌 MCP / 工具生态",
      "search": [
        "(topic:mcp OR topic:mcp-server OR topic:mcp-client) stars:>=5000",
